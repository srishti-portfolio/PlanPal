# --- Core ---
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed frontend origins (your Vercel URL in production)
CORS_ORIGIN=http://localhost:5173
# Public URL of the frontend, used for links inside emails
APP_URL=http://localhost:5173

# --- Database (Render gives you this as "Internal Database URL") ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/planpal
# Set to true when connecting with the *external* Render URL (SSL required)
DATABASE_SSL=false

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=11

# --- Google Gen AI (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Email: pick ONE provider. With none set, emails are printed to the server log. ---
MAIL_FROM_NAME=PlanPal
MAIL_FROM_EMAIL=no-reply@example.com
# Option A: Brevo HTTP API (works on Render's free tier, which blocks SMTP ports)
BREVO_API_KEY=
# Option B: SMTP (e.g. Gmail with an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
